{
  "manifest_version": 3,
  "name": "Consello da Abogacía Galega",
  "version": "0.5.0",
  "description": "Biblioteca de prompts comunes, documentos y jurisprudencia CENDOJ organizados por expediente, con panel lateral y lector en pestaña.",
  "action": {
    "default_title": "Consello da Abogacía Galega — abrir panel lateral",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite",
    "sidePanel",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.poderjudicial.es/search/*"
      ],
      "js": [
        "cendoj-content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
